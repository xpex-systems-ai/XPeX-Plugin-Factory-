PORT=8080
XPEX_FACTORY_ENV=development

# Optional: public base URL used only in status/docs responses.
XPEX_FACTORY_PUBLIC_URL=""

# Never place provider tokens or customer credentials in blueprints.


# Required only for production payment webhook verification.
# Never commit the real value.
STRIPE_WEBHOOK_SECRET=""

# Seller configuration: public receiving address only. No wallet private key.
# Disabled by default. Testnet is Arc Testnet; mainnet is Base only.
XPEX_X402_ENABLED=false
XPEX_X402_NETWORK=testnet
XPEX_X402_SELLER_ADDRESS=""
