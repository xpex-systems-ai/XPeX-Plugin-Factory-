{
  "name": "@xpex/plugin-factory",
  "version": "0.3.1",
  "private": false,
  "description": "Industrial OpenAI/Codex plugin, MCP and skill factory by XPeX Systems AI.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "xpex-plugin-factory": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "factory": "tsx src/cli.ts",
    "smoke:production": "node scripts/production-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "zod": "^4.1.11",
    "@circle-fin/x402-batching": "^3.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "mcpName": "io.github.xpex-systems-ai/xpex-plugin-factory",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "agent-tools",
    "plugins",
    "skills",
    "xpex",
    "codex"
  ]
}
